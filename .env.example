# Copy to .env and fill in. Command line flags and environment variables take precedence.

# Plex database copied from the server (opened read-only)
PLEX_DB_PATH=com.plexapp.plugins.library.db
# Plex Web: an item's "Get Info" > "View XML", X-Plex-Token in the URL
PLEX_TOKEN=

# simkl (default) or plex (the Plex account)
#SYNC_TARGET=simkl

# Simkl app registered as "TV, devices & command line" (no redirect URI or secret)
SIMKL_CLIENT_ID=
# Written by `plex_history.py simkl-login` (or the first non-dry export run)
#SIMKL_ACCESS_TOKEN=
#SIMKL_REFRESH_TOKEN=
#SIMKL_ACCOUNT_ID=
#SIMKL_NOT_FOUND_DAYS=30
#SIMKL_CACHE_DAYS=30

# TMDB v3 API key or v4 read token, needed for --title
#TMDB_API_KEY=
#TMDB_CACHE_DAYS=7
#ANIME_IDS_PATH=anime_ids.json

# 0-3
#VERBOSITY=1
# 1 prefixes log lines with the time
#LOG_TIMESTAMPS=0

# Filters apply to every run until removed
#FILTER_GUID_REGEX=
#FILTER_TITLE_REGEX=
#FILTER_TITLE=
#FILTER_YEAR=
#FILTER_START=0
#FILTER_COUNT=
